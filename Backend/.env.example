# Yogashrini Backend Platform - Environment Variables Template
# Copy this file to .env and insert your real production or local credentials.
# NEVER commit .env to any version control repository!

# Server Port & Mode
PORT=2000
NODE_ENV=development

# MongoDB Atlas Connection URI (Replace credentials with your MongoDB Atlas details)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/mern56?retryWrites=true&w=majority&appName=Cluster0

# JSON Web Token Secret & Expiry
JWT_SECRET=your_ultra_secure_jwt_secret_change_me_in_production
JWT_EXPIRES=7d

# Initial Administrator Credentials (used by /admin/add seed route)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@yogashrini.com
ADMIN_PASSWORD=change_this_admin_password

# Razorpay Payment Gateway Credentials (https://dashboard.razorpay.com/)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# AI & LLM Model Inference Gateways
GROQ_API_KEY=your_groq_api_key
GEMINI_API_KEY=your_gemini_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
MISTRAL_API_KEY=your_mistral_api_key
HUGGINGFACE_API_KEY=your_huggingface_api_key

# Frontend Client URL (for CORS production whitelist)
CLIENT_URL=http://localhost:3000
